{
  "name": "bufferlogic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "demo": "npm run build && node dist/examples/scenario1.js",
    "schedule": "npm run --silent build && node dist/src/cli.js",
    "compare": "npm run --silent build && node dist/src/compare-cli.js",
    "percentiles": "npm run --silent build && node dist/src/percentiles-cli.js",
    "progress": "npm run --silent build && node dist/src/progress-cli.js",
    "compare-progress": "npm run --silent build && node dist/src/compare-progress-cli.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
